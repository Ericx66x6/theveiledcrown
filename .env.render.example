# Cole os valores reais somente no Environment do Render.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SECRET_KEY=preencha-com-a-nova-chave-privada
SUPABASE_IMAGE_BUCKET=coroa-imagens
BOOTSTRAP_TOKEN=gere-uma-chave-aleatoria-de-pelo-menos-32-caracteres
NODE_ENV=production
NODE_VERSION=24
TRUST_PROXY=1
# Depois de publicar o Vercel, inclua aqui a origem exata dele:
ALLOWED_ORIGINS=

# Somente durante uma atualização/conversão, use 1. Operação normal: 0.
COROA_MAINTENANCE=0
